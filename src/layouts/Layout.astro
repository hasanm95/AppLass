---
import { getLangFromUrl, localePath } from '../i18n/utils';
import '../globals.css';
import '../fonts.css';
import '../tw-animate.css';
import { localize } from '@/i18n/localize';
import { getMindfulGuardSchema } from '@/constants/mindful-guard-data';
import { i18nConfig, localeMeta, isRtl } from '@/i18n/config';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  lang?: string;
  ogType?: string;
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  breadcrumbs?: { name: string; item: string }[];
  /**
   * Locales this specific page exists in. Defaults to every configured locale,
   * which is correct for static pages. Partially translated content (blog posts)
   * must pass the real set — an hreflang alternate for a page that was never
   * built points search engines at a 404.
   */
  availableLocales?: readonly string[];
}

const {
  title,
  description,
  keywords,
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
  lang,
  ogType = "website",
  articleMeta,
  breadcrumbs,
  availableLocales = i18nConfig.locales,
} = Astro.props;

// Get language from URL if not explicitly provided
const documentLang = lang || getLangFromUrl(Astro.url);

const defaultDescription = localize("At AppLass, we bridge the gap between complex mathematics and human-centric software. Stop letting bloated software slow down your growth. We build elite-tier Shopify and Mobile tools driven by mathematical precision.");
const defaultTitle = localize("AppLass | High-Performance Software Engineering");
const defaultKeywords = localize("software studio, Shopify apps, digital wellness, accessibility, WCAG, web development, AppLass");

const optimizedOgImage = ogImage || "https://applass.com/og-image.png";

// Properly construct language-specific URLs for SEO indexing
const localePrefixPattern = new RegExp(`^/(${i18nConfig.locales.join('|')})(/|$)`);
let basePath = Astro.url.pathname.replace(localePrefixPattern, '/');
if (basePath !== '/' && basePath.endsWith('/')) {
  basePath = basePath.slice(0, -1);
}
const hreflangAlternates = availableLocales.map((locale) => ({
  locale,
  url: `https://applass.com${localePath(locale, basePath)}`,
}));
const enUrl = `https://applass.com${basePath}`;

let canonicalPath = Astro.url.pathname;
if (canonicalPath !== '/' && canonicalPath.endsWith('/')) {
  canonicalPath = canonicalPath.slice(0, -1);
}
const canonicalUrl = `https://applass.com${canonicalPath}`;

const currentOgLocale = localeMeta[documentLang as keyof typeof localeMeta]?.ogLocale || 'en_US';
const alternateOgLocales = availableLocales
  .filter((l) => l !== documentLang)
  .map((l) => localeMeta[l as keyof typeof localeMeta]?.ogLocale)
  .filter((l): l is string => Boolean(l));

const defaultBreadcrumbs = [
  {
    name: localize("Home"),
    item: `https://applass.com${localePath(documentLang, '/')}`
  }
];

const finalBreadcrumbs = breadcrumbs || defaultBreadcrumbs;

// Single source of truth for Mindful Guard's schema fields (avoids drift between
// this global @graph entry and the page-specific schema in mindful-guard-data.ts).
const mindfulGuardSchema = getMindfulGuardSchema();

---

<!doctype html>
<html lang={documentLang} dir={isRtl(documentLang) ? "rtl" : "ltr"} class="font-sans antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#020617" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="AppLass" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Preload Fonts to prevent CLS -->
    <link rel="preload" href="/fonts/ibm-plex-sans-v23-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-v23-latin-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-v23-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-v23-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-v24-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-v24-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-v24-latin-700.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang for i18n -->
    {hreflangAlternates.map(({ locale, url }) => (
      <link rel="alternate" hreflang={locale} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Primary Meta Tags -->
    <title>{title || defaultTitle}</title>
    <meta name="title" content={title || defaultTitle} />
    <meta name="description" content={description || defaultDescription} />
    <meta name="keywords" content={keywords || defaultKeywords} />
    <meta name="author" content="AppLass" />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    {ogType === "article" && articleMeta && (
      <>
        {articleMeta.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
        {articleMeta.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
        {articleMeta.author && <meta property="article:author" content={articleMeta.author} />}
        {articleMeta.tags && articleMeta.tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta property="og:url" content={ogUrl || canonicalUrl} />
    <meta property="og:title" content={ogTitle || title || defaultTitle} />
    <meta property="og:description" content={ogDescription || description || defaultDescription} />
    <meta property="og:image" content={optimizedOgImage} />
    <meta property="og:site_name" content={localize("AppLass")} />
    <meta property="og:locale" content={currentOgLocale} />
    {alternateOgLocales.map((ogLocale) => (
      <meta property="og:locale:alternate" content={ogLocale} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={ogUrl || canonicalUrl} />
    <meta name="twitter:title" content={ogTitle || title || defaultTitle} />
    <meta name="twitter:description" content={ogDescription || description || defaultDescription} />
    <meta name="twitter:image" content={optimizedOgImage} />

    <!-- Fonts -->
    <style is:global>
      :root {
        /* We define font variables here so Tailwind can pick them up if configured */
        --font-sans: 'IBM Plex Sans', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, monospace;
      }
    </style>

    <!-- Google Analytics -->
    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://www.googletagmanager.com" />
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
        <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          // eslint-disable-next-line prefer-rest-params
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- JSON-LD Unified Entity & Product Schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://applass.com/#organization",
          "name": localize("AppLass"),
          "url": "https://applass.com",
          "logo": "https://applass.com/logo.png",
          "description": localize("Logic-driven software studio building high-performance apps with mathematical precision. Creators of ScreenVeil (10K+ downloads, 4.4★), FomoGen, and Mindful Guard."),
          "foundingDate": "2019",
          "sameAs": []
        },
        {
          "@type": "SoftwareApplication",
          "name": "ScreenVeil",
          "operatingSystem": "Android",
          "applicationCategory": "Utility",
          "author": {
            "@id": "https://applass.com/#organization"
          },
          "description": localize("Black overlay for AMOLED/OLED displays that saves 60%+ battery life while listening to videos."),
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.4",
            "reviewCount": "43"
          },
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "interactionStatistic": {
            "@type": "InteractionCounter",
            "interactionType": "https://schema.org/DownloadAction",
            "userInteractionCount": "10000"
          }
        },
        {
          "@type": "SoftwareApplication",
          "name": "FomoGen",
          "operatingSystem": "Shopify",
          "applicationCategory": "BusinessApplication",
          "author": {
            "@id": "https://applass.com/#organization"
          },
          "description": localize("Elite social proof tool with a <2.1KB payload to boost Shopify engagement by +23% without performance debt."),
          "featureList": localize("WCAG 2.1 Compliance, Real-time Nudges, Zero Performance Impact")
        },
        {
          "@type": "SoftwareApplication",
          "name": "Mindful Guard",
          "operatingSystem": mindfulGuardSchema.operatingSystem,
          "applicationCategory": mindfulGuardSchema.applicationCategory,
          "author": {
            "@id": "https://applass.com/#organization"
          },
          "description": mindfulGuardSchema.description,
          "aggregateRating": mindfulGuardSchema.aggregateRating,
          "featureList": localize("Zero-Tracking Architecture, System-Level Blocking, Focus Timers")
        },
        {
          "@type": "BreadcrumbList",
          "@id": `${canonicalUrl}/#breadcrumb`,
          "itemListElement": finalBreadcrumbs.map((crumb, idx) => ({
            "@type": "ListItem",
            "position": idx + 1,
            "name": crumb.name,
            "item": crumb.item
          }))
        }
      ]
    })}>
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <main id="main-content" class="relative flex min-h-screen flex-col">
      <slot />
    </main>
  </body>
</html>
