---
import { i18nConfig } from "@/i18n/config";
import { getBlogPosts } from "@/lib/blog";
import BlogPostPage from "@/page-templates/BlogPostPage.astro";

export async function getStaticPaths() {
  const nonDefaultLocales = i18nConfig.locales.filter(
    (l) => l !== i18nConfig.defaultLocale
  );

  // Build a path for every English slug in every locale, even if that
  // locale's translation is missing — BlogPostPage falls back to the
  // English post rather than 404ing when a translation doesn't exist.
  const englishPosts = await getBlogPosts(i18nConfig.defaultLocale);

  const paths = nonDefaultLocales.flatMap((lang) =>
    englishPosts.map((post) => ({
      params: { lang, slug: post.slug },
    }))
  );

  return paths;
}

const { lang, slug } = Astro.params;
---

<BlogPostPage lang={lang as any} slug={slug!} />
