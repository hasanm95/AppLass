---
import { i18nConfig } from "@/i18n/config";
import { getBlogPosts } from "@/lib/blog";
import BlogPostPage from "@/page-templates/BlogPostPage.astro";

export async function getStaticPaths() {
  const nonDefaultLocales = i18nConfig.locales.filter(
    (l) => l !== i18nConfig.defaultLocale
  );

  // Only build a localized route when that locale actually has the post.
  // The English fallback in getBlogPostBySlug still exists as a safety net, but
  // relying on it here would publish English content under a localized URL —
  // declared in hreflang and the sitemap as if it were a translation.
  const paths = (
    await Promise.all(
      nonDefaultLocales.map(async (lang) => {
        const translated = await getBlogPosts(lang);
        return translated.map((post) => ({ params: { lang, slug: post.slug } }));
      })
    )
  ).flat();

  return paths;
}

const { lang, slug } = Astro.params;
---

<BlogPostPage lang={lang as any} slug={slug!} />
