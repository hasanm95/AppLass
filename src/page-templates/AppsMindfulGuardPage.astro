---
import Layout from '../layouts/Layout.astro';
import Footer from "@/components/common/Footer.astro";
import Navbar from "@/components/common/Navbar.astro";
import MindfulHero from "@/components/apps/mindful-guard/MindfulHero.astro";
import LogicSection from "@/components/apps/mindful-guard/LogicSection.astro";
import DifferentiatorsSection from "@/components/apps/mindful-guard/DifferentiatorsSection.astro";
import ComparisonMatrix from "@/components/apps/mindful-guard/ComparisonMatrix.astro";
import MindfulFAQSection from "@/components/apps/mindful-guard/MindfulFAQSection.astro";
import MindfulStatsBar from "@/components/apps/mindful-guard/MindfulStatsBar.astro";
import MindfulSocialProof from "@/components/apps/mindful-guard/MindfulSocialProof.astro";
import MindfulPricing from "@/components/apps/mindful-guard/MindfulPricing.astro";
import MindfulClosingCTA from "@/components/apps/mindful-guard/MindfulClosingCTA.astro";
import { getMindfulGuardSchema } from "@/constants/mindful-guard-data";
import { i18nConfig } from "@/i18n/config";
import { localize } from "@/i18n/localize";

interface Props {
  lang: typeof i18nConfig.locales[number];
}

const { lang } = Astro.props;

import { setLocale } from "@/i18n";
setLocale(lang);

const isDefault = lang === "en";
const lastUpdated = "2026-07-24";
const mindfulSchema = {
  ...getMindfulGuardSchema(),
  "datePublished": "2024-02-15",
  "dateModified": lastUpdated,
  "author": {
    "@type": "Person",
    "name": "Hasan M.",
    "jobTitle": "Founder & Lead Engineer",
    "url": "https://applass.com/about"
  }
};

const meta = {
  title: "Block Reels, Shorts & TikTok on Android — Mindful Guard",
  description: "Block Instagram Reels, YouTube Shorts & TikTok on Android. Set daily limits that hold — 100% offline, zero data collected, free to download.",
  keywords: localize("block instagram reels android, block youtube shorts, tiktok blocker android, shorts blocker, reels blocker, android app blocker, limit short-form video, dopamine detox app, offline app blocker, zero telemetry"),
  ogTitle: localize("Block Reels, Shorts & TikTok on Android — Mindful Guard"),
  ogDescription: localize("A free Android app blocker with Reel Guard: cap Instagram Reels, YouTube Shorts & TikTok with daily and per-session limits. 100% offline. Zero data collected."),
  ogImage: "https://applass.com/mindful-guard-feature.png",
  ogUrl: isDefault ? "https://applass.com/apps/mindful-guard" : `https://applass.com/${lang}/apps/mindful-guard`
};

---

<Layout 
  title={meta.title || "Mindful Guard: The #1 Privacy-First Focus App [Android 2026]"}
  description={meta.description || "Stop digital distractions instantly. Mindful Guard is a 100% private, offline Pomodoro and app blocker for Android. Download for free today!"}
  keywords={meta.keywords}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
  ogUrl={meta.ogUrl}
  lang={lang}
>
  <Navbar    />
  {/* SoftwareApplication Schema for SEO - Critical for Google to display app details */}
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(mindfulSchema)}
  />
  <div class="flex-1">
    {/* Section 1: The Hero (Above the Fold) */}
    <MindfulHero>
      <div slot="meta" class="mb-4 flex flex-wrap items-center gap-3 sm:mb-6 sm:gap-4 justify-start">
        <span class="rounded-full bg-emerald-50 px-3 py-1 text-[10px] font-bold text-emerald-700 border border-emerald-100">
          {localize("Last checked: ")} {lastUpdated}
        </span>
        <span class="hidden h-1 w-1 rounded-full bg-slate-200 sm:block"></span>
        <span class="text-[10px] font-bold text-slate-600 italic">
          {localize("Verified: zero data collected")}
        </span>
      </div>

      <div slot="ai-summary" class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 rounded-2xl border border-slate-100 bg-white/60 px-4 py-4 text-left shadow-sm sm:mt-8 sm:gap-x-8 sm:px-6 sm:py-5 md:mt-10 lg:justify-start">
        <span class="flex items-center gap-2 text-sm font-bold text-slate-700">
          <span class="h-2 w-2 rounded-full bg-[#22C55E]"></span>
          {localize("100% offline")}
        </span>
        <span class="flex items-center gap-2 text-sm font-bold text-slate-700">
          <span class="h-2 w-2 rounded-full bg-[#22C55E]"></span>
          {localize("Zero data collected")}
        </span>
        <span class="flex items-center gap-2 text-sm font-bold text-slate-700">
          <span class="h-2 w-2 rounded-full bg-[#22C55E]"></span>
          {localize("Free to start")}
        </span>
        <span class="flex items-center gap-1 text-sm font-bold text-amber-700">
          ★★★★★ <span class="ml-1 text-slate-500">5.0 · 500+ installs</span>
        </span>
      </div>
    </MindfulHero>

    {/* Stats Bar */}
    <MindfulStatsBar />

    {/* Section 2: The Differentiators (Reel Guard leads) */}
    <DifferentiatorsSection />

    {/* Section 3: The Logic (The "Why") */}
    <LogicSection />

    {/* Section 4: The Comparison Matrix (Conversion Driver) */}
    <ComparisonMatrix />
 
    {/* Social Proof */}
    <MindfulSocialProof />

    {/* Pricing Section */}
    <MindfulPricing />

    {/* Section 5: FAQ */}
    <MindfulFAQSection />

    {/* Closing CTA */}
    <MindfulClosingCTA />
  </div>
  <Footer />
</Layout>
