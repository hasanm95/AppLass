---
import Layout from '../layouts/Layout.astro';
import Footer from "@/components/common/Footer.astro";
import Navbar from "@/components/common/Navbar.astro";
import Hero from "@/components/home/Hero.astro";
import SocialProof from "@/components/home/SocialProof.astro";
import ProductShowcase from "@/components/home/ProductShowcase.astro";
import Testimonials from "@/components/home/Testimonials.astro";
import FoundersMoat from "@/components/home/FoundersMoat.astro";
import SolutionsSection from "@/components/home/SolutionsSection.astro";
import AnswerNuggets from "@/components/home/AnswerNuggets.astro";
import { i18nConfig } from "@/i18n/config";
import { setLocale } from "@/i18n";
import { localize } from "@/i18n/localize";

interface Props {
  lang: typeof i18nConfig.locales[number];
}

const { lang } = Astro.props;
setLocale(lang);
const isDefault = lang === "en"; 
const meta = {
  title: localize("AppLass: Android Apps and Shopify Tools, Built Small and Private"),
  description: localize("ScreenVeil plays video with your screen off. Mindful Guard blocks distracting apps on-device. FomoGen adds social proof to your Shopify store. None of them track you."),
  keywords: localize("ScreenVeil, Mindful Guard, FomoGen, screen off video playback, app blocker Android, Shopify social proof, no tracking apps, AppLass"),
  ogTitle: localize("AppLass — ScreenVeil, Mindful Guard and FomoGen"),
  ogDescription: localize("Three apps for Android and Shopify. No trackers, no accounts, no bloat."),
  ogImage: "https://applass.com/og-home.png",
  ogUrl: isDefault ? "https://applass.com" : `https://applass.com/${lang}`
};

---

<Layout 
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
  ogUrl={meta.ogUrl}
  lang={lang}
>
  <Navbar    />
  <Hero />
  <SocialProof />
  <ProductShowcase />
  <Testimonials />
  <FoundersMoat />
  <SolutionsSection />
  <AnswerNuggets />
  <Footer />
</Layout>
