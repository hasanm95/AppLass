---
import Section from "@/components/common/Section.astro";
import { getSolutions } from "@/constants/home-data";
import { BatteryCharging, ShieldOff, ShoppingBag } from "lucide-react";
import { localize } from "@/i18n/localize";
import { getLangFromUrl, localePath } from "@/i18n/utils";

const ICONS = {
  BatteryCharging,
  ShieldOff,
  ShoppingBag,
};

const lang = getLangFromUrl(Astro.url);
const solutionsData = getSolutions();
---

<Section
  id="solutions"
  className="bg-muted py-16 md:py-24 lg:py-32"
>
  <div class="section-container">
    {/* Section Header */}
    <div class="mb-16 md:mb-24">
      <div class="mb-8 flex items-center gap-4">
        <span class="font-mono text-xs font-bold tracking-widest text-muted-foreground uppercase">
        {localize("FIND YOUR APP")}
      </span>
      <span class="block h-px flex-1 bg-foreground/20" />
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <h2 class="font-mono text-2xl leading-tight font-bold text-foreground md:text-3xl lg:text-4xl">
          {localize("Which one")}
          <br />
          <span class="text-muted-accent">
            {localize("do you need?")}
          </span>
        </h2>

        <div class="flex items-end">
          <p class="max-w-md text-lg leading-relaxed text-muted-foreground">
            {localize("Pick the problem that sounds like yours.")}
          </p>
        </div>
      </div>
    </div>

    {/* App Chooser Grid */}
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {solutionsData.map((solution, index) => {
        const Icon = ICONS[solution.iconName as keyof typeof ICONS];

        return (
          <a
            href={localePath(lang, solution.href)}
            class="group block cursor-pointer border border-border bg-background p-6 transition-all duration-200 hover:border-cta md:p-8"
          >
            {/* Number */}
            <div class="mb-6 flex items-center justify-between">
              <span class="font-mono text-xs font-bold tracking-widest text-muted-foreground uppercase">
                0{index + 1}
              </span>
              <div class="flex h-10 w-10 items-center justify-center border border-border transition-all duration-200 group-hover:border-cta group-hover:bg-cta/5">
                {Icon && (
                  <Icon className="h-5 w-5 text-muted-foreground transition-colors group-hover:text-cta-text" />
                )}
              </div>
            </div>

            <span class="mb-6 block h-px w-16 bg-foreground/20" />

            <h3 class="mb-3 font-mono text-lg font-bold text-foreground md:text-xl">
              {solution.title}
            </h3>
            <p class="text-sm leading-relaxed text-muted-foreground">
              {solution.description}
            </p>
          </a>
        );
      })}
    </div>
  </div>
</Section>
