---
import { localePath } from "@/i18n/utils";
import { playUrl } from "@/lib/utils";
import { localize } from "@/i18n/localize";

interface Props {
  appName: "Mindful Guard" | "FOMOgen" | "AppLass" | "ScreenVeil";
  lang?: string;
  labels?: {
    learnMore?: string;
    poweredByLogic?: string;
    sub?: string;
    desc?: string;
  };
}

const { appName, lang = "en", labels } = Astro.props;

const data = {
  "Mindful Guard": {
    title: "Mindful Guard",
    sub: labels?.sub || localize("Built for Focus."),
    desc: labels?.desc || localize("Reclaim your digital focus with logical guardrails."),
    href: playUrl("blog-callout", "blog"),
    color: "bg-[#047857]",
    learnMoreText: localize("Download on Play Store"),
    external: true,
  },
  FOMOgen: {
    title: "FOMOgen",
    sub: labels?.sub || localize("Sales Simplified."),
    desc: labels?.desc || localize("The #1 Shopify app for social proof automation."),
    href: "/apps/fomogen",
    color: "bg-blue-600",
    learnMoreText: localize("Learn More"),
    external: false,
  },
  AppLass: {
    title: "The Logic Lab",
    sub: labels?.sub || localize("First Principles."),
    desc: labels?.desc || localize("Get engineering insights delivered to your inbox."),
    href: "#subscribe",
    color: "bg-slate-900",
    learnMoreText: localize("Subscribe"),
    external: false,
  },
  ScreenVeil: {
    title: "ScreenVeil",
    sub: labels?.sub || localize("Screen Off Video for Android."),
    desc: labels?.desc || localize("Black overlay keeps audio playing while saving 60%+ battery on AMOLED. 10,000+ downloads · 4.4 ★ · Free forever."),
    href: "https://play.google.com/store/apps/details?id=com.screenveil.app",
    color: "bg-[#22d3ee]",
    learnMoreText: localize("Download on Play Store"),
    external: true,
  },
}[appName];
---

<div class="group relative overflow-hidden rounded-4xl border border-slate-900 bg-white p-8">
  <div
    class={`absolute top-0 right-0 h-24 w-24 ${data.color} translate-x-12 -translate-y-12 rounded-full opacity-[0.03] blur-2xl transition-opacity group-hover:opacity-[0.1]`}
  ></div>

  <span class="mb-6 block text-[10px] font-black tracking-[0.2em] text-slate-500 uppercase">
    {labels?.poweredByLogic || (appName === "ScreenVeil" ? localize("Featured in this article") : localize("Powered by Logic"))}
  </span>

  <h4 class="mb-2 text-2xl font-black text-slate-900">{data.title}</h4>
  <p class="mb-6 text-sm font-bold text-slate-600">{data.sub}</p>

  <p class="mb-8 text-sm leading-relaxed font-medium text-slate-600">
    {data.desc}
  </p>

  <a
    href={data.external ? data.href : localePath(lang, data.href)}
    target={data.external ? "_blank" : undefined}
    rel={data.external ? "noopener noreferrer" : undefined}
    class={`inline-flex h-12 w-full items-center justify-center rounded-xl font-bold text-white transition-opacity hover:opacity-90 ${data.color}`}
    style={appName === "ScreenVeil" ? "color: #0f172a;" : undefined}
  >
    {data.learnMoreText}
  </a>
</div>
