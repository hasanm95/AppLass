---
// src/components/blog/ScreenVeilCTA.astro
// Drop <ScreenVeilCTA /> anywhere in your MDX files.
// Matches your site's dark theme and tech aesthetic.
---

<a
  href="https://play.google.com/store/apps/details?id=com.screenveil.app"
  target="_blank"
  rel="noopener noreferrer"
  class="screenveil-cta"
  aria-label="Download ScreenVeil on Google Play — free Android app"
>
  <div class="screenveil-cta__left">
    <span class="screenveil-cta__badge">Free Android App</span>
    <span class="screenveil-cta__title">ScreenVeil — Screen Off Video</span>
    <span class="screenveil-cta__desc">
      Black-out your screen while audio plays. Saves 60%+ battery on AMOLED.
      10,000+ downloads · 4.4 ★ · Zero permissions.
    </span>
  </div>
  <div class="screenveil-cta__right" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/>
      <path d="m10 8 6 4-6 4V8z"/>
    </svg>
    <span>Get it free</span>
  </div>
</a>

<style>
  .screenveil-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    margin: 2rem 0;
    border: 1px solid #22d3ee33;
    border-left: 3px solid #22d3ee;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, #0f172a 0%, #0c1a2e 100%);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .screenveil-cta:hover {
    border-color: #22d3ee99;
    background: linear-gradient(135deg, #0f172a 0%, #0d2340 100%);
  }

  .screenveil-cta__left {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .screenveil-cta__badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #22d3ee;
  }

  .screenveil-cta__title {
    font-size: 1rem;
    font-weight: 600;
    color: #f1f5f9;
    line-height: 1.3;
  }

  .screenveil-cta__desc {
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.4;
    margin-top: 2px;
  }

  .screenveil-cta__right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: #22d3ee;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .screenveil-cta {
      flex-direction: column;
      align-items: flex-start;
    }

    .screenveil-cta__right {
      flex-direction: row;
      gap: 8px;
    }
  }
</style>
