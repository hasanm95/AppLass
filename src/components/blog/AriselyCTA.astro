---
// src/components/blog/AriselyCTA.astro
import { localize } from "@/i18n/localize";

interface Props {
  lang?: string;
  /** utm_campaign for Play install attribution, e.g. the post slug. */
  campaign?: string;
}

const { campaign = "blog-cta" } = Astro.props;
const referrer = encodeURIComponent(`utm_source=applass&utm_medium=blog&utm_campaign=${campaign}`);
const href = `https://play.google.com/store/apps/details?id=com.arisely&referrer=${referrer}`;

const content = {
  badge: localize("Free Android App · No Account"),
  title: localize("Arisely — The Alarm You Can't Sleep Through"),
  desc: localize("Rings at full volume until you finish a wake-up mission: math, memory, steps, a barcode across the room, or camera-checked push-ups. No data collected."),
  btn: localize("Install free"),
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="arisely-cta"
  aria-label={localize("Download Arisely on Google Play — free Android alarm clock")}
>
  <div class="arisely-cta__left">
    <span class="arisely-cta__badge">{content.badge}</span>
    <span class="arisely-cta__title">{content.title}</span>
    <span class="arisely-cta__desc">
      {content.desc}
    </span>
  </div>
  <div class="arisely-cta__right" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/>
      <path d="m10 8 6 4-6 4V8z"/>
    </svg>
    <span>{content.btn}</span>
  </div>
</a>

<style>
  .arisely-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    margin: 2rem 0;
    border: 1px solid #a78bfa33;
    border-left: 3px solid #a78bfa;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, #1e1033 0%, #2e1065 100%);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .arisely-cta:hover {
    border-color: #a78bfa99;
    background: linear-gradient(135deg, #1e1033 0%, #3b0f80 100%);
  }

  .arisely-cta__left {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .arisely-cta__badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c4b5fd;
  }

  .arisely-cta__title {
    font-size: 1rem;
    font-weight: 600;
    color: #f1f5f9;
    line-height: 1.3;
  }

  .arisely-cta__desc {
    font-size: 0.8rem;
    color: #cbd5e1;
    line-height: 1.4;
    margin-top: 2px;
  }

  .arisely-cta__right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: #c4b5fd;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .arisely-cta {
      flex-direction: column;
      align-items: flex-start;
    }

    .arisely-cta__right {
      flex-direction: row;
      gap: 8px;
    }
  }
</style>
