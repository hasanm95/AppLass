---
// src/components/blog/FomogenCTA.astro
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
const isFr = lang === "fr";

const content = {
  badge: isFr ? "Application Shopify · Plan Gratuit" : "Shopify App · Free Plan Available",
  title: "FOMOgen — Real-Time Social Proof",
  desc: isFr
    ? "Augmentez vos ventes avec des notifications d'achat en temps réel, des compteurs de visiteurs et des barres de livraison gratuite. Moins de 2.1KB, zéro ralentissement."
    : "Boost Shopify conversion rates with real-time recent sales notifications, live visitor counters, and dynamic free shipping bars. Under 2.1KB payload, zero page speed impact.",
  btn: isFr ? "Voir sur Shopify" : "Install Free",
};
---

<a
  href="https://apps.shopify.com/fomogen"
  target="_blank"
  rel="noopener noreferrer"
  class="fomogen-cta"
  aria-label="Install FomoGen Free on Shopify Store"
>
  <div class="fomogen-cta__left">
    <span class="fomogen-cta__badge">{content.badge}</span>
    <span class="fomogen-cta__title">{content.title}</span>
    <span class="fomogen-cta__desc">
      {content.desc}
    </span>
  </div>
  <div class="fomogen-cta__right" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/>
      <path d="m10 8 6 4-6 4V8z"/>
    </svg>
    <span>{content.btn}</span>
  </div>
</a>

<style>
  .fomogen-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    margin: 2rem 0;
    border: 1px solid #3b82f633;
    border-left: 3px solid #3b82f6;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, #0f172a 0%, #0b1e3b 100%);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .fomogen-cta:hover {
    border-color: #3b82f699;
    background: linear-gradient(135deg, #0f172a 0%, #0d2b5c 100%);
  }

  .fomogen-cta__left {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .fomogen-cta__badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3b82f6;
  }

  .fomogen-cta__title {
    font-size: 1rem;
    font-weight: 600;
    color: #f1f5f9;
    line-height: 1.3;
  }

  .fomogen-cta__desc {
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.4;
    margin-top: 2px;
  }

  .fomogen-cta__right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: #3b82f6;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .fomogen-cta {
      flex-direction: column;
      align-items: flex-start;
    }

    .fomogen-cta__right {
      flex-direction: row;
      gap: 8px;
    }
  }
</style>
