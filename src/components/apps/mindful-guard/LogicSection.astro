---
import Section from "@/components/common/Section.astro";
import { getMindfulGuardData } from "@/constants/mindful-guard-data";

const mindfulData = getMindfulGuardData();
const dict = mindfulData.logic;
const labels = mindfulData.labels;
---

<Section id="logic" className="border-y border-slate-200 bg-[#FBFBFA] py-10 sm:py-14 md:py-16 lg:py-20 2xl:py-24">
  <div class="section-container">
    <div class="flex flex-col gap-10 sm:gap-12 lg:flex-row lg:items-center lg:gap-10 2xl:gap-16">
      <div class="flex-1 lg:max-w-xl">

        <h2 class="mb-4 text-3xl leading-tight font-black tracking-tight text-slate-950 sm:mb-6 sm:text-4xl md:mb-8 md:text-5xl 2xl:text-6xl">
          {dict.title}
        </h2>
        <p class="mb-6 text-base leading-relaxed font-medium text-slate-600 sm:mb-8 sm:text-lg md:mb-12 md:text-xl">
          {dict.description}
        </p>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
          <div class="rounded-2xl border border-emerald-100 bg-emerald-50/50 p-5 sm:p-6">
            <p class="leading-tight font-bold text-slate-900">
              {labels.interceptsDistractions}
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:p-6">
            <p class="leading-tight font-bold text-slate-900">
              {labels.zeroWillpowerArchitecture}
            </p>
          </div>
        </div>
      </div>

      <div class="relative w-full lg:flex-1">
        <div class="relative aspect-4/3 overflow-hidden rounded-3xl border border-slate-200 bg-white p-4 shadow-xl shadow-slate-200/50 sm:p-6 md:p-8">
          <div class="relative flex h-full w-full flex-col items-center justify-center rounded-2xl border border-slate-100 bg-slate-50/50">
            {/* Calm Flow Visual */}
            <div class="relative flex h-48 w-full max-w-md items-center justify-center sm:h-56 md:h-64">
              <div class="absolute h-[2px] w-full bg-slate-200" />

              {/* Nodes */}
              <div class="relative z-10 flex h-full w-full items-center justify-around">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border border-slate-200 bg-white text-[11px] font-bold text-slate-500 shadow-sm sm:h-14 sm:w-14 sm:text-xs md:h-16 md:w-16">
                  {labels.input}
                </div>
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[#15803D] text-[11px] font-bold text-white shadow-lg shadow-emerald-900/20 sm:h-20 sm:w-20 sm:text-xs md:h-24 md:w-24">
                  {labels.filter}
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-full border border-slate-200 bg-white text-[11px] font-bold text-slate-500 shadow-sm sm:h-14 sm:w-14 sm:text-xs md:h-16 md:w-16">
                  {labels.focus}
                </div>
              </div>

              {/* Flow Lines */}
              <div class="absolute top-1/2 left-[20%] h-1 w-[15%] border-t-2 border-dashed border-slate-300" />
              <div class="absolute top-1/2 left-[45%] h-1 w-[15%] border-t-2 border-dashed border-[#16A34A]/60" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>
