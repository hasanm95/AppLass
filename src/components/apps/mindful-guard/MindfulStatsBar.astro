---
import Section from "@/components/common/Section.astro";
import { localize } from "@/i18n/localize";
---
<Section className="relative border-b shadow-sm border-slate-200 bg-[#FBFBFA] border-t py-6 sm:py-8 md:py-10">
  <div class="section-container relative z-10 w-full max-w-7xl">
    <div class="grid grid-cols-2 gap-6 sm:gap-8 md:flex md:flex-row md:justify-around lg:gap-10 2xl:gap-16">
      <div class="text-center">
        <p class="text-2xl font-black text-slate-900 sm:text-3xl md:text-4xl">2.4h</p>
        <p class="mt-1 text-[11px] font-bold tracking-widest text-slate-500 uppercase sm:mt-2 sm:text-xs">{localize("Focus Reclaimed Daily")}</p>
      </div>
      <div class="text-center">
        <p class="text-2xl font-black text-slate-900 sm:text-3xl md:text-4xl">100%</p>
        <p class="mt-1 text-[11px] font-bold tracking-widest text-slate-500 uppercase sm:mt-2 sm:text-xs">{localize("On-Device — No Cloud")}</p>
      </div>
      <div class="text-center">
        <p class="text-2xl font-black text-slate-900 sm:text-3xl md:text-4xl">0ms</p>
        <p class="mt-1 text-[11px] font-bold tracking-widest text-slate-500 uppercase sm:mt-2 sm:text-xs">{localize("Blocking Latency")}</p>
      </div>
      <div class="text-center">
        <p class="text-2xl font-black text-slate-900 sm:text-3xl md:text-4xl">Zero</p>
        <p class="mt-1 text-[11px] font-bold tracking-widest text-slate-500 uppercase sm:mt-2 sm:text-xs">{localize("Telemetry")}</p>
      </div>
    </div>
  </div>
</Section>
