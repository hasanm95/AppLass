          <Star className="h-4 w-4 fill-current" />
          <Star className="h-4 w-4 fill-current" />
          <Star className="h-4 w-4 fill-current" />
        </div>
        <p class="mb-6 italic text-slate-700">{localize("Excellent focus app for studying. The Pomodoro-style focus sessions and custom app lists make it easy to block distractions and concentrate better.")}</p>
        <div class="mt-auto">
          <p class="font-bold text-slate-900">{localize("Hasnat Rabby")}</p>
          <p class="text-xs font-medium uppercase tracking-widest text-slate-400 mt-1">{localize("GOOGLE PLAY")}</p>
        </div>
      </div>

      {/* Testimonial 2 */}
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm sm:p-8">
        <div class="flex gap-1 mb-4 text-amber-400">
