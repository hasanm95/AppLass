---
import Section from "@/components/common/Section.astro";
import { localize } from "@/i18n/localize";
import { Star } from "lucide-react";

// DEVELOPER NOTE: Real reviews from Google Play console.
---

<Section className="bg-white border-t border-emerald-900/10 py-10 sm:py-14 md:py-16 2xl:py-20">
  <div class="section-container">
    <div class="mb-8 text-center max-w-2xl mx-auto flex flex-col items-center sm:mb-10 md:mb-12">
      <!-- We only use verifiable claims -->
      <div class="flex gap-1 mb-3 text-emerald-500 sm:mb-4">
        <Star className="h-4 w-4 fill-current sm:h-5 sm:w-5" />
        <Star className="h-4 w-4 fill-current sm:h-5 sm:w-5" />
        <Star className="h-4 w-4 fill-current sm:h-5 sm:w-5" />
        <Star className="h-4 w-4 fill-current sm:h-5 sm:w-5" />
        <Star className="h-4 w-4 fill-current sm:h-5 sm:w-5" />
      </div>
      <h2 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl md:text-4xl">
        {localize("Rated highly by people returning to reality")}
      </h2>
      <p class="mt-3 text-base text-slate-600 sm:mt-4 sm:text-lg">
        {localize("MindfulGuard's completely offline strict mode is designed for those who refuse to compromise on privacy.")}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3">
      {/* Testimonial 1 */}
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm sm:p-8">
