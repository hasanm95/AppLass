---
import Section from "@/components/common/Section.astro";
import { getMindfulGuardData } from "@/constants/mindful-guard-data";
import { Shield, Zap, Lock, Clapperboard, HelpCircle, type LucideIcon } from "lucide-react";
import { cn } from "@/lib/utils";

const ICON_MAP: Record<string, LucideIcon> = {
  Shield,
  Zap,
  Lock,
  Clapperboard,
};

const mindfulData = getMindfulGuardData();
const diffs = mindfulData.differentiators;
const labels = mindfulData.labels;
---

<Section id="differentiators" className="bg-white py-10 sm:py-14 md:py-16 lg:py-20 2xl:py-24">
  <div class="section-container">
    <div class="mb-8 max-w-3xl sm:mb-10 md:mb-12 2xl:mb-16">
      <h2 class="text-3xl leading-tight font-black tracking-tight text-slate-950 sm:text-4xl md:text-5xl 2xl:text-6xl">
        {labels.technicalAdvantages}{" "}
        <span class="text-slate-300">{labels.technicalAdvantagesAccent}</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3">
      {diffs.map((feature: any) => {
        const Icon = ICON_MAP[feature.iconName || ""] || HelpCircle;

        return (
          <div class="group relative rounded-2xl border border-slate-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[#16A34A]/40 hover:shadow-lg sm:p-8 2xl:p-10">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-slate-50 text-slate-500 transition-all duration-300 group-hover:bg-[#16A34A] group-hover:text-white sm:mb-6 sm:h-14 sm:w-14 2xl:mb-8">
              <Icon className="h-6 w-6 sm:h-7 sm:w-7" />
            </div>

            <h3 class="mb-2 text-sm font-bold text-[#15803D] sm:mb-3">
              {feature.title}
            </h3>

            <p class="text-base leading-snug font-semibold text-slate-700 sm:text-lg">
              {feature.description}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</Section>
