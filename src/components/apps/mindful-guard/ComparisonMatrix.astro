---
import Section from "@/components/common/Section.astro";
import { getMindfulGuardData } from "@/constants/mindful-guard-data";
import { Check, X, Minus } from "lucide-react";

const mindfulData = getMindfulGuardData();
const comparison = mindfulData.comparison;
const competitors = comparison.competitors;
const labels = mindfulData.labels;

---

<Section id="comparison" className="border-b border-slate-200 bg-[#FBFBFA] py-10 sm:py-14 md:py-16 lg:py-20 2xl:py-24">
  <div class="section-container">
    <div class="mb-8 sm:mb-10 md:mb-12 2xl:mb-20">

      <h2 class="text-2xl font-black tracking-tight text-slate-950 sm:text-3xl md:text-4xl 2xl:text-5xl">
        {comparison.title}
      </h2>
    </div>

    {/* Desktop Table */}
    <div class="hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:block">
      <table class="w-full border-collapse">
        <thead>
          <tr class="bg-slate-900">
            <th class="p-6 2xl:p-8 text-left text-xs font-bold text-slate-400">
              {labels.technicalSpec}
            </th>
            <th class="bg-[#15803D] p-6 2xl:p-8 text-left text-xs font-bold text-white">
              {labels.mindfulGuardVersion}
            </th>
            <th class="p-6 2xl:p-8 text-left text-xs font-bold text-slate-400">
              {competitors.opal}
            </th>
            <th class="p-6 2xl:p-8 text-left text-xs font-bold text-slate-400">
              {competitors.freedom}
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {comparison.specs?.map((spec: any) => (
            <tr class="transition-colors hover:bg-slate-50">
              <td class="p-6 2xl:p-8 font-bold text-slate-900">
                {spec.label}
              </td>
              <td class="bg-emerald-50/40 p-6 2xl:p-8">
                {true ? (
                  <span class="flex items-center gap-3 text-sm font-bold text-[#15803D]">
                    <Check className="h-4 w-4 stroke-[3px]" />
                    {spec.mindfulGuard}
                  </span>
                ) : null}
              </td>
              <td class="p-6 2xl:p-8">
                {spec.opal.includes("High") || spec.opal.includes("$99") ? (
                  <span class="flex items-center gap-3 text-sm text-red-800">
                    <X className="h-4 w-4" />
                    {spec.opal}
                  </span>
                ) : (
                  <span class="flex items-center gap-3 text-sm text-slate-500">
                    <Minus className="h-4 w-4" />
                    {spec.opal}
                  </span>
                )}
              </td>
              <td class="p-6 2xl:p-8">
                {spec.freedom.includes("High") || spec.freedom.includes("$99") ? (
                  <span class="flex items-center gap-3 text-sm text-red-800">
                    <X className="h-4 w-4" />
                    {spec.freedom}
                  </span>
                ) : (
                  <span class="flex items-center gap-3 text-sm text-slate-500">
                    <Minus className="h-4 w-4" />
                    {spec.freedom}
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Mobile Cards */}
    <div class="space-y-3 sm:space-y-4 md:hidden">
      {comparison.specs?.map((spec: any) => (
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="bg-slate-900 p-4">
            <h3 class="text-xs font-bold text-white">
              {spec.label}
            </h3>
          </div>
          <div class="space-y-4 p-5 sm:space-y-6 sm:p-6">
            <div class="flex items-center justify-between border-b border-emerald-100 pb-4">
              <span class="text-xs font-bold text-[#15803D]">
                MindfulGuard
              </span>
              <span class="flex items-center gap-3 text-sm font-bold text-[#15803D]">
                <Check className="h-4 w-4 stroke-[3px]" />
                {spec.mindfulGuard}
              </span>
            </div>
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
              <span class="text-xs font-bold text-slate-600">
                {competitors.opal}
              </span>
              {spec.opal.includes("High") || spec.opal.includes("$99") ? (
                <span class="flex items-center gap-3 text-sm text-red-800">
                  <X className="h-4 w-4" />
                  {spec.opal}
                </span>
              ) : (
                <span class="flex items-center gap-3 text-sm text-slate-500">
                  <Minus className="h-4 w-4" />
                  {spec.opal}
                </span>
              )}
            </div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-600">
                {competitors.freedom}
              </span>
              {spec.freedom.includes("High") || spec.freedom.includes("$99") ? (
                <span class="flex items-center gap-3 text-sm text-red-800">
                  <X className="h-4 w-4" />
                  {spec.freedom}
                </span>
              ) : (
                <span class="flex items-center gap-3 text-sm text-slate-500">
                  <Minus className="h-4 w-4" />
                  {spec.freedom}
                </span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>
