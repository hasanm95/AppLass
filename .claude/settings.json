{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hasanm025/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hasanm025/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(adb devices*)",
      "Bash(graphify query *)",
      "Bash(npm view *)",
      "Bash(graphify --help)",
      "Bash(graphify explain *)"
    ]
  }
}